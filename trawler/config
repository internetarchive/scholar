[http]
# Connection pooling for every outbound HTTP call trawler makes. SPN, CDX and
# the Wayback replay fetches all talk to web.archive.org, so they share one
# pool and these numbers are about that host above all.
#
# max_idle_conns_per_host is the one worth tuning. Go's own default is 2, which
# means that past two requests in flight to web.archive.org every further one
# opens a fresh connection, pays a TLS handshake, and is thrown away instead of
# pooled on the way out. Size it at or above the crawl requests a worker can
# have in flight -- scrape.worker_activity_slots is the practical bound -- and
# leave headroom. Too high costs idle sockets; too low costs a handshake per
# request.
max_idle_conns_per_host = 64
# max_idle_conns is the process-wide ceiling across all hosts.
max_idle_conns = 512
# idle_conn_timeout is how long an unused pooled connection is kept.
idle_conn_timeout = "90s"
# response_header_timeout bounds a server that accepts a connection and then
# says nothing, which is how a crawl wedges and holds its activity slot until
# the heartbeat timeout. It does not limit reading the body, so a slow PDF
# replay is unaffected. Generous on purpose -- CDX can be slow and we would
# rather wait than re-crawl. Set it to 0 to disable.
response_header_timeout = "120s"

