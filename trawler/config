# This is an example config file. For actual deployments of trawler, a path of
# /etc/trawler/config is recommended for this file. However, the following
# paths are checked:
# - /etc/trawler/config
# - $HOME/.config/trawler/config
# - .
[s3]
endpoint = "wbgrp-svc314.us.archive.org:8333"
access_id = ""
secret_key = ""

[temporal]
hostport = "" # blank to use temporal sdk default

[scholkit]
path = "/usr/local/bin/sk-feed"
# dataDir = "/var/data/trawler"
dataDir = "./data"

[crossref]
temporal_namespace = "dev.crossref"
temporal_namespace_retention = "8760h"
internal_task_queue = "crossref_crawl_internal"
external_task_queue = "crossref_crawl_external"
#every = "24h"
every = "120s"
sks3bucket = "sk-crossref"
default_limit = 1000 # for dev; typically would be -1 for unlimited

[fatcat1]
endpoint = "https://scholar.archive.org/api/fatcat/v1"

[crawling]
user_agent = "Mozilla/5.0 ias_trawler"
doi_prefix_blocklist = [
  # gbif.org: many DOIs, not PDF fulltext
  "10.15468/",
  # ssl.fao.org: gene data
  "10.18730/",
  # plutof.ut.ee: gene data
  "10.15156/",
  # ba.e-pics.ethz.ch: swiss image (photo) archive
  "10.3932/",
  # ccdc.cam.ac.uk: crystal structures
  "10.5517/",
  # researchgate: mostly blocks our crawler
  "10.13140/",
  # springerlink: mostly blocks crawler
  "10.1007/",
  # nature group: mostly blocks crawler
  "10.1038/",
  # SAGE: mostly blocks crawler
  "10.1177/",
  # IOP: mostly blocks crawler
  "10.1088/",
  # JSTOR: mostly blocks crawler
  "10.2307/",
  # arxiv: duplicates with arxiv identifiers (temporary)
  "10.48550/",
  # figshare: including until I understand where and how version is set
  "10.6084/",
  "10.25384/",
  # IPK Gatersleben Genebank -- datasets only, non pdf
  "10.25642/ipk/gbis",
]

url_blocklist = [

  # generally unwanted patterns

  "//localhost/",
  "//127.0.0.1/",
  # robot blocking / rate-limited
  "//hkvalidate.perfdrive.com/",
  "//ieeexplore.ieee.org/",
  # temporary, until we implement specific fetch and 'petabox' output
  "//archive.org/",
  "//www.archive.org/",
  "//web.archive.org/web/",
  # out of scope
  "//openlibrary.org/",
  "//www.openlibrary.org/",
  "//fatcat.wiki/",
  "//scholar.archive.org/",
  "//orcid.org/",
  # Domain squats
  "//bartandjones.com",
  "//ijretm.com",
  "//ijrcemas.com",
  "//jist.net.in",
  "//croisements-revue.org",
  # all stubs/previews, not full papers
  "//page-one.live.cf.public.springer.com",
  # large datasets-only (no PDF expected)
  "plutof.ut.ee/",
  "www.gbif.org/",
  "doi.pangaea.de/",
  "www.plate-archive.org/",
  "//apex.ipk-gatersleben.de/",
  "fao.org/glis/",
  # Historical non-paper content:
  "dhz.uni-passau.de/",  # newspapers
  "digital.ucd.ie/",  # ireland national historical
  # deprecated domain (doesn't redirect correctly)
  "//edoc.mpg.de/",
  # bogus/spam PDFs
  "//isiarticles.com/",
  # requested to be not crawled in 2023
  "//unsworks.unsw.edu.au/",
  # 403s since 2020.
  "sciencedirect.com",
  # no success since 2023 (can do in browser but it's captcha'd)
  "sciencedirectassets.com",
  # this worked until 2023; I do see a way to get a download link if we let JS
  # load and pull it from the "previous version" dropdown but it uses a
  # different ID and requires either a good regex or HTML parsing. Can unblock
  # if we get that working.
  "osf.io",
  # bot-walled as of may 2024; pdf links now 403ing
  "researchgate.net",
  # This broke in 2023; frustratingly, the PDFs are still in the same place and
  # easy to download but something is wrong with their page such that 3 reloads
  # of the same URL are necessary to get to the actual landing page. If we put
  # effort in we could likely special case this with a pile of cookies /
  # repeated requests but at this moment it doesn't seem worth it.
  "journals.tsu.ru",
  # broken since 2022; domain times out
  "aed.org.cn",
  # bryan had a hack for this domain but we never got anything from it. we get lots of stuff from library. but not dlc.library.
  "dlc.library.columbia.edu",
  # service seems totally gone
  "fldeploc.dep.state.fl.us",
  # JS-walled, now. Could compute the url with some messy regexes if we felt like it.
  "preprints.jmir.org",
  # JS-walled, now. Could possibly compute the url with some messy regexes if we felt like it.
  "bloomsburycollections.com",

  # loginwall patterns

  "//profile.thieme.de/HTML/sso/ejournals/login.htm",
  "//login.bepress.com/",
  "?SAMLRequest=",
  "//osapublishing.org/captcha/",
  "/password-login",
  "//gateway.isiknowledge.com/",
  "/login?TARGET=",
  "jstage.jst.go.jp/sblogin",
  "//acw.elsevier.com/SSOCore",
  "//acw.sciencedirect.com/SSOCore",
  "/login?source=",

  # cookiewall patterns

  "/cookieAbsent",
  "cookieSet=1",
  "error=cookies_not_supported",
  # SPNv2 seems to work (not end up here), but heritrix fails
  "//secure.jbs.elsevierhealth.com/",
]

# these URL patterns imply a direct PDF download we can obtain with a "simple"
# get in SPN
# Simple GETs
#  'Tis a GET to the server, 'tis a GET 403,
#  'Tis a GET to download a PDF for me,
#  And when we find our query with no Chrome in sight,
#  'Twill be in the archive of our petabyte. -avd
simple_get_list = [
  # TODO
  "journals.plos.org/plosone/article/file?id=",
  "tidsskrift.dk/spr/article/download/",
  "scholarscompass.vcu.edu/cgi/viewcontent.cgi?article=",
]

[fatcat2]
endpoint = "https://scholar.archive.org/api/fatcat/v2"
key = ""

[spn]
access_key = ""
secret_key = ""
endpoint = "https://web.archive.org/save"

[cdx]
auth = ""
endpoint = "https://web.archive.org/cdx/search/cdx"
user_agent = "Mozilla/5.0 ias_trawler_cdx_client"
backoff = 10s
retries = 4

[wayback]
replay_endpoint = "https://web.archive.org/web/"
retries = 4
backoff = 10s
