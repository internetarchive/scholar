[crawling]
# cdx_freshness_cutoff is how old an already-archived capture may be and still
# be used as-is. Anything older and the crawler spends SPN time on a fresh
# capture instead.
cdx_freshness_cutoff = "672h" # four weeks
# cdx_rows_per_lookup is how many of a URL's most recent captures the crawler
# asks CDX for before deciding whether to call SPN. It walks them newest-first
# and takes the first it can act on -- a 2xx, a redirect, or a revisit --
# within cdx_freshness_cutoff. Raising it gives more chances to reuse an
# existing capture when the newest rows are 404s or unreplayable records.
cdx_rows_per_lookup = 10
# spn_slot_poll_interval is how long to wait between attempts when SPN has no
# capture session free. The scrape workflow also reuses it as the delay before
# Temporal redelivers a URL it deferred for the same reason.
spn_slot_poll_interval = "12s"
spn_job_poll_interval = "20s"
# spn_slot_status_ttl is how long a reading of SPN's free-session count
# (/status/user) is reused before a crawl re-queries it. The reading is shared
# by every crawl in a worker, so this collapses a burst of them into one query;
# keep it short, since the count moves as fast as captures start and finish.
spn_slot_status_ttl = "5s"
# body_stall_timeout is how long a Wayback replay body may make no progress at
# all before the crawl gives up on it. The transport's timeouts all fire before
# the first byte arrives; this covers the read that follows, which is otherwise
# unbounded and is how a crawl wedges and keeps its activity slot for good.
# It bounds a stall, not a slow download: a large PDF that keeps streaming is
# never interrupted, however long it takes. Set to 0 to disable.
body_stall_timeout = "60s"
user_agent = "Mozilla/5.0 ias_trawler"
