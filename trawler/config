# This is an example config file. For actual deployments of trawler, a path of
# /etc/trawler/config is recommended for this file. However, the following
# paths are checked:
# - /etc/trawler/config
# - $HOME/.config/trawler/config
# - .
[sentry]
dsn = "https://b917e17fa01e2aee8a07bcc6a933a5d0@sentry.archive.org/75"

[harvesting]
batch_size = 10000
chunk_size = 102400

[daily]
# lines_per_can bounds how many ndjson lines a single DailyCrawlWorkflow run
# processes before handing off to a fresh run via ContinueAsNew. This keeps any
# one run's Temporal history well under the ~10k-event / 50MB limits. Each
# ProcessLine is roughly 3-5 history events, so ~2000 lines keeps a run under
# ~10k events. Defaults to 2000 if unset or <= 0.
lines_per_can = 2000

[periodic]
task_queue = "periodic_ingest"
# cursed_shas and url_ignore_patterns are re-read from this file on every
# ProcessPdfLine activity execution, so edits take effect on a running worker
# (the next activity execution, including a retry, picks them up).
# cursed_shas are base32 sha1s of PDFs that wedge the ingest pipeline.
cursed_shas = [ ]
# url_ignore_patterns are substrings of URLs we do not want to ingest.
url_ignore_patterns = [ ]

[scrape]
# The "scrape to wayback" workflow: walk a flat list of URLs and push each one
# through SPN. No fatcat records, no indexing -- just capture.
task_queue = "scrape_to_wayback"
# concurrency is how many crawls the workflow keeps in flight. It is the main
# throttle and can be retuned on a running scrape with
# `trawler scrape set-concurrency --list <key> --concurrency N`.
concurrency = 4
# max_concurrency clamps both the start flag and the retune signal, so a typo
# cannot point a thousand parallel crawls at SPN.
max_concurrency = 64
# worker_activity_slots caps concurrent crawl activities on a single worker.
# With several workers on the queue this is what actually bounds total load.
worker_activity_slots = 8
# urls_per_can bounds how many URLs one workflow run dispatches before handing
# off via ContinueAsNew, keeping any single run's history well under Temporal's
# limits.
urls_per_can = 2000
# batch_size is how many URLs one S3 range read returns; chunk_size is how many
# bytes it reads at a time.
batch_size = 1000
chunk_size = 102400
# max_consecutive_errors aborts the run when this many crawls in a row exhaust
# their retries. Individual dead URLs are expected and never fail the run, but a
# long unbroken streak means something systemic (bad SPN credentials, SPN down)
# and is not worth burning millions of URLs against.
max_consecutive_errors = 50
# max_hops bounds how many redirects/link-follows a single crawl will chase.
max_hops = 8
# log_dir is where the per-URL outcome TSV is written, on whichever worker host
# ran the crawl. One file per scrape, named for the workflow id. Leave empty to
# disable the log.
log_dir = "./data/scrape-logs"

